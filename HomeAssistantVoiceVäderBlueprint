    sensor_trigger_settings:
      name: Sensorutlösta meddelanden
      description: Aktivera väderuppdateringar som utlöses av sensordetektering, perfekt för att läsa upp prognoser när du kommer hem.
      icon: mdi:motion-sensor
      collapsed: true
      input:
        enable_sensor_triggered:
          name: Aktivera sensorutlösta meddelanden
          description: Slå på/av för att aktivera vädermeddelanden när en sensor utlöses (t.ex. när någon kommer hem).
          default: false
          selector:
            boolean: {}
        presence_sensors:
          name: Sensorer
          description: Binära sensorentiteter som upptäcker närvaro (t.ex. rörelse- eller närvarosensorer).
          default: []
          selector:
            entity:
              domain: binary_sensor
              multiple: true
    alarm_based_settings:
      name: Larmbaserat meddelande
      description: Konfigurera webhook-utlösta personliga väderrapporter, t.ex. för väckarklockor. Webhook-URL:en formateras som "http://homeassistant.local:8123/api/webhook/(webhook-id)".
      icon: mdi:alarm
      collapsed: true
      input:
        enable_alarm_announce:
          name: Aktivera larmbaserat meddelande
          description: Slå på/av för att aktivera webhook-utlösta personliga vädermeddelanden.
          default: false
          selector:
            boolean: {}
        webhook_id:
          name: Webhook-ID
          description: Anpassat ID för webhook-utlösaren. Hela URL:en blir "http://homeassistant.local:8123/api/webhook/(ditt-id-här)".
          default: "wakeup_alarm"
          selector:
            text: {}
        personal_name:
          name: Personligt namn
          description: Namn för en personlig hälsning i väderrapporten (t.ex. "Johan").
          default: ""
          selector:
            text: {}
        alarm_volume_level:
          name: Larmvolymnivå
          description: Volymnivån för larmbaserade meddelanden (intervall 0 till 1, där 1 är maximal volym).
          default: 0.6
          selector:
            number:
              min: 0
              max: 1
              step: 0.01
              mode: slider
    change_settings:
      name: Förändringsmeddelanden
      description: Hantera varningar för aktuella och kommande väderförändringar, t.ex. när det börjar regna.
      icon: mdi:weather-cloudy-alert
      collapsed: true
      input:
        enable_current_change_announce:
          name: Aktivera meddelanden vid aktuell förändring
          description: Slå på/av för att aktivera meddelanden när det aktuella vädret ändras (t.ex. från soligt till regnigt).
          default: true
          selector:
            boolean: {}
        current_change_volume_level:
          name: Volymnivå vid aktuell förändring
          description: Volymnivån för dessa meddelanden (intervall 0 till 1).
          default: 0.6
          selector:
            number:
              min: 0
              max: 1
              step: 0.01
              mode: slider
        enable_upcoming_change_announce:
          name: Aktivera meddelanden vid kommande förändring
          description: Slå på/av för att aktivera meddelanden för kommande väderförändringar, t.ex. annalkande nederbörd.
          default: true
          selector:
            boolean: {}
        upcoming_change_volume_level:
          name: Volymnivå vid kommande förändring
          description: Volymnivån för dessa meddelanden (intervall 0 till 1).
          default: 0.6
          selector:
            number:
              min: 0
              max: 1
              step: 0.01
              mode: slider
        minutes_before_announce:
          name: Minuter innan kommande meddelande
          description: Antal minuter innan en kommande väderförändring (t.ex. när regnet börjar) som meddelandet ska ges.
          default: 30
          selector:
            number:
              min: 15
              max: 60
              step: 15
              unit_of_measurement: minuter
    precip_settings:
      name: Nederbördsinställningar
      description: Finjustera hur nederbörd hanteras i prognoser och varningar. Ställ in tröskelvärden för sannolikhet för att undvika onödiga meddelanden.
      icon: mdi:weather-rainy
      collapsed: true
      input:
        precip_threshold:
          name: Tröskelvärde för nederbördssannolikhet (%)
          description: Den minsta procentuella sannolikheten som krävs för att potentiellt regn/snö ska nämnas.
          default: 30
          selector:
            number:
              min: 0
              max: 100
              unit_of_measurement: "%"
        hours_ahead:
          name: Timmar framåt för prognos
          description: Antal timmar framåt att kontrollera nederbörd i timprognoser.
          default: 24
          selector:
            number:
              min: 1
              max: 48
              unit_of_measurement: timmar
        hourly_segments_count:
          name: Antal timprognossegment
          description: Antal viktiga timförändringar som ska läsas upp (t.ex. nederbörd, stora temperaturförändringar).
          default: 3
          selector:
            number:
              min: 1
              max: 6
        temp_change_threshold:
          name: Tröskelvärde för temperaturförändring (grader)
          description: Minsta temperaturförändring (grader) mellan timmar för att nämnas i timsegment (t.ex. "Temperaturen sjunker till 15 grader vid klockan 19:00").
          default: 5
          selector:
            number:
              min: 3
              max: 15
              unit_of_measurement: "°"
        daily_forecast_days:
          name: Dagar för dygnsprognos
          description: Antal dagar framåt som ska nämnas i dygnsprognossegmentet (imorgon, nästa dag, etc.).
          default: 3
          selector:
            number:
              min: 1
              max: 5
        wind_speed_threshold:
          name: Tröskelvärde för vindhastighet
          description: Minsta vindhastighet för att nämnas i prognoser. Vindar under detta tröskelvärde ignoreras.
          default: 15
          selector:
            number:
              min: 5
              max: 30
              unit_of_measurement: "m/s"
        wind_gust_threshold:
          name: Tröskelvärde för vindbyar
          description: Minsta hastighet på vindbyar för att nämnas separat från ihållande vind.
          default: 20
          selector:
            number:
              min: 10
              max: 50
              unit_of_measurement: "m/s"
    voice_satellite_settings:
      name: Röstsatellit
      description: Konfigurera röstaktiverade väderrapporter för assistenter.
      icon: mdi:microphone-message
      collapsed: true
      input:
        enable_voice_satellite:
          name: Aktivera röstsatellit
          description: Slå på/av för att aktivera konversationsbaserade utlösare. Automationen lyssnar efter angivna fraser och svarar med en uppläst väderprognos.
          default: false
          selector:
            boolean: {}
        conversation_command:
          name: Konversationskommando
          description: Anpassade fraser (en per rad) för att utlösa väderprognosen (t.ex. "Hur är vädret").
          default: "Hur blir vädret idag\nHur är vädret\nVad är det för väder"
          selector:
            text:
              multiline: true
trigger_variables:
  enable_time_based: !input enable_time_based
  enable_sensor_triggered: !input enable_sensor_triggered
  enable_current_change_announce: !input enable_current_change_announce
  enable_upcoming_change_announce: !input enable_upcoming_change_announce
  minutes_before_announce: !input minutes_before_announce
  enable_alarm_announce: !input enable_alarm_announce
  enable_voice_satellite: !input enable_voice_satellite
trigger:
  - trigger: time_pattern
    hours: !input hour_pattern
    minutes: !input minute_offset
    id: time_based
  - trigger: state
    entity_id: !input presence_sensors
    to: "on"
    id: sensor_trigger
  - trigger: state
    entity_id: !input weather_entity
    id: current_change
  - trigger: time_pattern
    minutes: "/5"
    id: upcoming_change
  - trigger: webhook
    allowed_methods:
      - POST
      - PUT
      - GET
      - HEAD
    local_only: true
    webhook_id: !input webhook_id
    id: alarm_webhook
  - trigger: conversation
    command: "{{ conversation_command.split('\n') }}"
    id: voice_satellite
condition:
  - condition: or
    conditions:
      - condition: and
        conditions:
          - condition: trigger
            id: time_based
          - condition: time
            after: !input start_time
            before: !input end_time
          - condition: template
            value_template: "{{ enable_time_based }}"
          - "{{ not days_of_week or now().strftime('%a').lower()[:3] in days_of_week }}"
      - condition: and
        conditions:
          - condition: trigger
            id: sensor_trigger
          - condition: template
            value_template: "{{ enable_sensor_triggered }}"
      - condition: and
        conditions:
          - condition: trigger
            id: current_change
          - condition: template
            value_template: "{{ enable_current_change_announce }}"
      - condition: and
        conditions:
          - condition: trigger
            id: upcoming_change
          - condition: template
            value_template: "{{ enable_upcoming_change_announce }}"
      - condition: and
        conditions:
          - condition: trigger
            id: alarm_webhook
          - condition: template
            value_template: "{{ enable_alarm_announce }}"
      - condition: and
        conditions:
          - condition: trigger
            id: voice_satellite
          - condition: template
            value_template: "{{ enable_voice_satellite }}"
action:
  - variables:
      key: !input weather_entity
      spoken: ""
  - choose:
      - conditions:
          - condition: or
            conditions:
              - condition: trigger
                id: time_based
              - condition: trigger
                id: sensor_trigger
        sequence:
          - action: weather.get_forecasts
            target:
              entity_id: !input weather_entity
            data:
              type: daily
            response_variable: d
          - action: weather.get_forecasts
            target:
              entity_id: !input weather_entity
            data:
              type: hourly
            response_variable: h
          - variables:
              precip_threshold: !input precip_threshold
              hours_ahead: !input hours_ahead
              hourly_segments_count: !input hourly_segments_count
              daily_forecast_days: !input daily_forecast_days
              temp_change_threshold: !input temp_change_threshold
              wind_speed_threshold: !input wind_speed_threshold
              wind_gust_threshold: !input wind_gust_threshold
              now_hour: "{{ now().hour }}"
              day_name: "{{ (now() | as_timestamp | timestamp_custom('%A', true)) }}"
              now_temp: "{{ state_attr(key,'temperature') }}"
              now_hum: "{{ state_attr(key,'humidity') }}"
              now_wind: "{{ state_attr(key,'wind_speed') | float(0) | round(0) | int }}"
              now_gust: "{{ state_attr(key,'wind_gust_speed') | float(0) | round(0) | int }}"
              now_cond_h: "{% set s = (states(key) or '') | lower %} {% set s = s | replace('_',' ') | replace('-',' ') | replace('partlycloudy','halvklart') | replace('clearnight','klart') | replace('cloudy','molnigt') | replace('sunny','soligt') | replace('rainy','regn') | replace('snowy','snö') | replace('fog','dimma') | replace('pouring','ösregn') | replace('lightning','åska') | replace('hail','hagel') | replace('clear','klart') %} {{ s | trim }}"
              daily_list: "{{ d.get(key,{}).get('forecast',[]) }}"
              today: "{{ daily_list[0] if daily_list|length>0 else dict() }}"
              high: "{{ today.get('temperature') }}"
              low: "{{ today.get('templow', today.get('temperature_low')) }}"
              hourly_list: "{{ h.get(key,{}).get('forecast',[]) }}"
              next_hours: "{{ hourly_list[:hours_ahead] if hourly_list else [] }}"
              current_time_12h: "{{ as_timestamp(now()) | timestamp_custom('%H:%M', true) }}"
              current_hour: "{{ now().hour }}"
              greeting: >-
                {% set h = current_hour | int %}
                {% if h >= 5 and h < 12 %}God morgon{% elif h >= 12 and h < 17 %}God eftermiddag{% elif h >= 17 and h < 21 %}God kväll{% else %}God natt{% endif %}
              opening_line: "{{ greeting }}. Klockan är {{ current_time_12h }}, och här är din väderprognos. "
              current_segment: >-
                {% set cond_phrase = '' %}
                {% if now_cond_h %}
                  {% set cond_phrase = 'Vi har just nu ' ~ (now_cond_h | lower) %}
                  {% if now_temp is not none %}
                    {% set cond_phrase = cond_phrase ~ ' med en temperatur på ' ~ (now_temp | round(0) | int) ~ ' grader' %}
                  {% endif %}
                  {% if now_hum is not none %}
                    {% set cond_phrase = cond_phrase ~ ' och en luftfuktighet på ' ~ now_hum ~ ' procent' %}
                  {% endif %}
                  {% set cond_phrase = cond_phrase ~ '. ' %}
                {% endif %}
                {% set wind_phrase = '' %}
                {% if now_wind >= wind_speed_threshold %}
                  {% if now_gust >= wind_gust_threshold and now_gust > (now_wind + 5) %}
                    {% set wind_phrase = 'Vinden ligger på runt ' ~ now_wind ~ ' m/s, med byar upp till ' ~ now_gust ~ ' m/s. ' %}
                  {% else %}
                    {% set wind_phrase = 'Vinden ligger på runt ' ~ now_wind ~ ' m/s. ' %}
                  {% endif %}
                {% elif now_gust >= wind_gust_threshold %}
                  {% set wind_phrase = 'Vindbyarna når upp till ' ~ now_gust ~ ' m/s. ' %}
                {% endif %}
                {% set day_phrase = '' %}
                {% if high is not none and low is not none %}
